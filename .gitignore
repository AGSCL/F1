#############################
# 1. Ignorar todo por defecto
#############################
*

# Permitir recorrer directorios
!*/

# Mantener el propio .gitignore
!.gitignore

########################################
# 2. Archivos que SÍ quiero versionar
########################################

# Quarto
!*.qmd
!_quarto.yml
!_quarto.yaml
!quarto.yml
!quarto.yaml
!*.qproj
!*.Rproj     # si usas RStudio projects

# HTML/CSS/JS/SCSS (salidas o assets del sitio)
!*.html
!*.css
!*.js
!*.mjs
!*.scss
!*.sass
!*.json      # a veces lo necesitas como config (puede quitarse si no aplica)

# Documentos básicos
!README*
!LICENSE*
!LICENCE*

# Imágenes y PDFs
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp
!*.pdf

# Archivo de lock de renv (importante para reproducibilidad)
!renv.lock

########################################
# 3. Ignorar cosas pesadas o innecesarias
########################################

# Carpeta renv completa
renv/
.Rprofile
.Renviron
.Rhistory
.RData
.Rproj.user/
.Ruserdata
.Rcache/

# Quarto cache/output
_site/
docs/
.quarto/

# Python / notebooks temporales
__pycache__/
.ipynb_checkpoints/
*.pyc

# Sistemas / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Comprimidos / temporales / logs
*.zip
*.tar.gz
*.rar
*.tmp
*.log

_data/step3.RData
